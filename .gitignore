# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Large experiment raw JSONL records (pinned via SHA-256 in pilot/w12_c_evidence_manifest.json)
pilot/*.jsonl
pilot/**/*.jsonl

# Track only the Manifest core reproducibility suite; keep all other local workspace files ignored
/*
!.gitignore
!pilot/

# Inside pilot/, whitelist only the Manifest-pinned suite and its direct Python import modules
pilot/*

